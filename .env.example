# Copy to .env and fill in your own values. Never commit .env.

# Required
TELEGRAM_BOT_TOKEN=123456789:replace-with-your-BotFather-token
GROQ_API_KEY=gsk_replace_with_your_groq_key

# Optional (defaults shown)
# GROQ_MODEL=openai/gpt-oss-120b
# GROQ_API_URL=https://api.groq.com/openai/v1/chat/completions
# DOCS_REPO=ogarcia/rucio
# DOCS_PATH=docs/user
# DOCS_REF=master
# DOCS_INCLUDE_README=true
# DOCS_CACHE=~/.cache/donrucio/docs.md
# DOCS_REFRESH_HOURS=6          # 0 disables periodic refresh
# GITHUB_TOKEN=                 # optional, raises GitHub API rate limit
# POLL_TIMEOUT_SECS=30
# CONTEXT_CHARS=14000           # retrieval budget (~3500 tokens)
# MAX_TOKENS=2048               # bound the answer so prompt+answer < 8000 TPM
# REASONING_EFFORT=low          # gpt-oss reasoning budget: low|medium|high
# HISTORY_MESSAGES=6            # past messages replayed for continuity (per chat)
# HISTORY_IDLE_MINS=30          # minutes idle before a chat starts fresh (0=off)
# SUGGESTIONS_FILE=             # JSONL log of flagged feature suggestions;
#                               # defaults beside the docs cache, empty disables
